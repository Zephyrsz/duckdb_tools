# Local OpenMuse + RDS deployment. Keep .env private.
WORKSPACE_MODE=sample
AGENT_BACKEND=model
HOST=127.0.0.1
PORT=8787
PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=false
WEB_SEARCH_ENABLED=false
COMPUTER_ENABLED=false
JEV_MODE=off

# Complete these locally before starting OpenMuse chat.
CPK_INTELLIGENCE_API_KEY=
MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_CHAT_COMPLETIONS=true

# Paths below are relative to data_agent_deploy/ for the Python API.
RDS_AGENT_ROOT=../../rds_agent
RDS_DB_PATH=../data/workspace.duckdb
RDS_METADATA_DB_PATH=../../rds_agent/var/metadata.db
RDS_API_PORT=8766
RDS_API_URL=http://127.0.0.1:8766
# setup.sh generates this shared server-only token automatically.
RDS_API_TOKEN=
