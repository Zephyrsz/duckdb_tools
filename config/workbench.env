# Shared local configuration for the FastAPI backend and Vite frontend.
# Environment variables exported by the shell override these defaults.
DUCKDB_TOOLS_HOST=0.0.0.0
DUCKDB_TOOLS_BACKEND_PORT=8001
DUCKDB_TOOLS_FRONTEND_PORT=5173
DUCKDB_TOOLS_DATA=./data
DUCKDB_TOOLS_DATABASE=./data/workspace.duckdb
# 上传临时文件目录；预览阶段保留，导入成功后删除，默认使用 $DUCKDB_TOOLS_DATA/uploads
DUCKDB_TOOLS_UPLOAD_DIR=./data/uploads
# 临时上传文件最长保留时间（秒）
DUCKDB_TOOLS_UPLOAD_RETENTION_SECONDS=86400
# 默认启动时自动连接 DuckDB；设为 false 时由前端手动连接
DUCKDB_AUTO_CONNECT=true
RDS_AGENT_ROOT=../rds_agent
RDS_AGENT_METADATA_DB=../rds_agent/var/metadata.db
RDS_DB_PATH=./data/workspace.duckdb
RDS_METADATA_DB_PATH=../rds_agent/var/metadata.db
